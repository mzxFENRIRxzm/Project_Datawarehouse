# ============================================
# Suphasan Data Warehouse - Environment Variables
# Copy this file to .env and fill in values
# ============================================

# --- PostgreSQL (OLTP + Metadata) ---
POSTGRES_USER=suphasan
POSTGRES_PASSWORD=changeme_pg_password
POSTGRES_DB=suphasan

# --- Apache Superset ---
SUPERSET_SECRET_KEY=changeme_superset_secret_key_minimum_42_characters_long
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@suphasan.com

# --- Apache Airflow ---
AIRFLOW_FERNET_KEY=changeme_fernet_key
AIRFLOW__CORE__EXECUTOR=CeleryExecutor

# --- Django ---
DJANGO_SECRET_KEY=changeme_django_secret_key
DJANGO_SETTINGS_MODULE=suphasan.settings
DJANGO_DEBUG=True

# --- Integrated Open Source Lakehouse ---
LAKEHOUSE_MINIO_USER=lakehouse_admin
LAKEHOUSE_MINIO_PASSWORD=change_this_minio_password
